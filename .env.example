# Copy to .env and fill in. Never commit .env.

# Database (used by docker compose)
POSTGRES_USER=yacinemotors
# Letters and digits only (e.g. openssl rand -hex 16): it is embedded in a connection URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yacinemotors

# Payload (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local development outside Docker only (db published by docker-compose.dev.yml)
# Keep the password and port in sync with POSTGRES_PASSWORD and DB_PORT
DB_PORT=5433
DATABASE_URI=postgres://yacinemotors:change-me@localhost:5433/yacinemotors

# Docker: load the initial catalog (vehicles.json) at start when there is no vehicle yet.
# Set to false once the client's own catalog is in place (ADR-0020).
AUTO_SEED=true

# Host port for nginx
HTTP_PORT=8080

# Public address of the site (absolute URLs of share previews, e.g. vehicle photos).
# Use the real domain once deployed.
SITE_URL=http://localhost:8080

# Telegram (Bot API). Create a bot with @BotFather, then get the chat id of the
# conversation or group that must receive the messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only to point to a fake server in tests (default https://api.telegram.org)
# TELEGRAM_API_URL=
