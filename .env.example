# Copy to .env and fill in. Never commit .env.

# Database (used by docker compose)
POSTGRES_USER=yacinemotors
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yacinemotors

# Payload (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Local development outside Docker only (db published on 127.0.0.1:5433 by the override file)
DATABASE_URI=postgres://yacinemotors:change-me@localhost:5433/yacinemotors

# Host port for nginx
HTTP_PORT=8080
